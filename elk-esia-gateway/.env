# ==============================================================================
# КОНФИГУРАЦИОННАЯ МАТРИЦА ЕСИА ШЛЮЗА-ТРАНСЛЯТОРА (Окружение: Стенд Тестирования)
# ==============================================================================

# 1. СИСТЕМНЫЕ НАСТРОЙКИ СЕТИ И ОРКЕСТРАЦИИ
HOST_PORT=8080
DOCKER_REGISTRY=local
GIN_MODE=debug

# 2. НАСТРОЙКИ ОБЛАЧНОГО ЛОГИРОВАНИЯ (SLOG)
# Для Теста/Разработки: "DEBUG" и "text" (удобный читаемый текст в консоли)
# Для Продакшена:      "INFO"  и "json" (структурированный JSON для ELK)
LOG_LEVEL=DEBUG
LOG_HANDLER=text

# 3. КРИПТОГРАФИЧЕСКИЙ КОНТУР OPENSSL ГОСТ
CRYPTO_SYSTEM=open-ssl-gost
# Абсолютные пути к файлам ключей ИС внутри контейнера
OPENSSL_KEY_PATH=/etc/esia/crypto/ca.key
OPENSSL_CERT_PATH=/etc/esia/crypto/ca.crt
# Пароль контейнера закрытого ключа ИС (если ключ не зашифрован - оставьте пустым)
OPENSSL_KEY_PASSWORD=

# 4. РЕКВИЗИТЫ АВТОРИЗАЦИИ В КОНТУРЕ ЕСИА МИНЦИФРЫ
# Мнемоника вашей Информационной Системы (Client ID), зарегистрированная в Техподдержке ЕСИА
GATEWAY_CLIENT_ID=TEST_ORB_LK
# Удаленный хост ЕСИА (esia-portal1.test.gosuslugi.ru - тест, esia.gosuslugi.ru - прод)
ESIA_TARGET_HOST=esia-portal1.test.gosuslugi.ru
ESIA_UPSTREAM_TIMEOUT=5

# 5. ПУТИ МОНТИРОВАНИЯ НА ХОСТ-МАШИНЕ
# Директория на сервере, где физически лежат ca.key и ca.crt для проброса в контейнер
CRYPTO_KEYS_DIR=./cert/esia
