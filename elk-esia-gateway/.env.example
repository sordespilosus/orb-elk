# Шаблон конфигурационной матрицы ЕСИА Шлюза. скопируйте этот файл в .env и заполните своими значениями
HOST_PORT=8080
GIN_MODE=release

LOG_LEVEL=INFO
LOG_HANDLER=json

CRYPTO_SYSTEM=open-ssl-gost
OPENSSL_KEY_PATH=/etc/esia/crypto/ca.key
OPENSSL_CERT_PATH=/etc/esia/crypto/ca.crt
OPENSSL_KEY_PASSWORD=your_secure_key_password_here

GATEWAY_CLIENT_ID=YOUR_SYSTEM_MNEMONIC
ESIA_TARGET_HOST=esia.gosuslugi.ru
ESIA_UPSTREAM_TIMEOUT=5

CRYPTO_KEYS_DIR=./prod/crypto/keys
